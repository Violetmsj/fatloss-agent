{
  "name": "fatloss-agent",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "tui": "node --env-file=.env node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js --provider deepseek --model deepseek-flash",
    "server": "node --env-file=.env --import tsx src/server/index.ts",
    "web:dev": "npm --prefix web run dev",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run server\" \"npm run web:dev\"",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:test": "npm --prefix web run test",
    "web:build": "npm --prefix web run build",
    "chroma": "chroma run --path data/chroma",
    "kb:index": "node --env-file=.env --import tsx src/knowledge/index.ts",
    "memory:eval": "node --env-file=.env --import tsx src/memory-evaluation.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "ai": "^7.0.106",
    "chromadb": "3.5.0",
    "express": "^5.2.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "concurrently": "^10.0.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
