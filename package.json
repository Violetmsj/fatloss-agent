{
  "name": "fatloss-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "tui": "node --env-file=.env node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js --provider deepseek --model deepseek-flash",
    "chroma": "chroma run --path data/chroma",
    "kb:index": "node --env-file=.env --import tsx src/knowledge/index.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "chromadb": "3.5.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
