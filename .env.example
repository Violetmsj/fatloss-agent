# 在百炼控制台创建 API Key，并把 Workspace ID 替换为你的实际值。
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings

# 可选；不填时默认连接 localhost:8000。
CHROMA_HOST=localhost
CHROMA_PORT=8000

# 可选；联网热量估算默认使用 Tavily keyless 模式，触及免费限额时再填写。
TAVILY_API_KEY=
